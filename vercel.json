{
  "rewrites": [
    { "source": "/sb/:path*", "destination": "https://rmcewweppablchrtctkw.supabase.co/:path*" },
    { "source": "/gt/:path*", "destination": "https://translate.googleapis.com/:path*" },
    { "source": "/lib/supabase.js", "destination": "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
  ]
}
